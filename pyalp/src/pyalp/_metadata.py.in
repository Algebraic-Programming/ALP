# pyalp/_metadata.py.in
"""
Runtime metadata for the pyalp package.

This file is generated by CMake from _metadata.py.in.
"""

__all__ = ["get_build_metadata", "get_algorithm_metadata"]

_build_metadata = {
    "version": "@pyalp_VERSION@",
    "build_type": "@CMAKE_BUILD_TYPE@",
    "alp_version": "@ALP_VERSION@",
    "alp_build_type": "@ALP_BUILD_TYPE@",
    "alp_git_commit": "@ALP_GIT_COMMIT_SHA@",
    "alp_git_branch": "@ALP_GIT_BRANCH@",
    "python_version": "@PYTHON_VERSION@",
    "pybind11_version": "@pybind11_VERSION@",
    "license": "@ALP_LICENSE@",
    "homepage": "https://github.com/Algebraic-Programming/graphblas",
}

_algorithm_metadata = {
    "algorithms": "@pyalp_ALGORITHMS@",
    "backends": "@pyalp_BACKENDS@",
}

# README content (may be large); inserted as a Python triple-quoted string.
_algorithm_metadata["readme"] = """@PYALP_README_ESCAPED@"""


def get_build_metadata():
    """Return a dictionary of build-time metadata."""
    return _build_metadata


def get_algorithm_metadata():
    """Return a dictionary of available algorithms and backends."""
    return _algorithm_metadata
